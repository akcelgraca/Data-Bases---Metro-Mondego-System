    {
      "name": "— AUTH — Login Super Admin",
      "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
        "const res = pm.response.json();",
        "if (res.status === 200) {",
        "    pm.environment.set('super_token', res.results);",
        "    console.log('super_token guardado');",
        "}"
      ]}}],
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n    \"username\": \"superadmin\",\n    \"password\": \"hash_super\"\n}", "options": {"raw": {"language": "json"}}},
        "url": {"raw": "http://localhost:8080/dbproj/user", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["dbproj","user"]}
      },
      "response": []
    },
    {
